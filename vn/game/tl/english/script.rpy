    pass

translate english calle_2_0066:
    voice "voice/calle_2_0066.ogg"
    c_mephisto "And yet I’m right!"

translate english calle_2_0067:
    voice "voice/calle_2_0067.ogg"
    c_faust "Mark this, I beg of thee!\nAnd spare my lungs henceforth: whoever\nIntends to have the right, if but his\ntongue be clever,"
    voice sustain
    c_faust "Will have it, certainly.\nBut come: the further talking brings\ndisgust,\nFor thou art right, especially since I"
    voice sustain
    c_faust "must."

