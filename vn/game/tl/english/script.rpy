    voice "voice/carcel_0221.ogg"
    c_margarita "What rises up from the threshold here?\nHe! he! suffer him not!\nWhat does he want in this holy spot?\nHe seeks me!"

translate english carcel_0224:
    voice "voice/carcel_0224.ogg"
    c_faust "Thou shalt live."

translate english carcel_0225:
    voice "voice/carcel_0225.ogg"
    c_margarita "Judgment of God! myself to thee I give."

translate english carcel_0226:
    pass

translate english carcel_0227:
    voice "voice/carcel_0227.ogg"
    c_mephisto "Come! or I’ll leave her in the lurch, and thee!"

