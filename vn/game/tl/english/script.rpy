    pass

translate english carcel_0235:
    voice "voice/carcel_0235.ogg"
    c_mephisto "She is judged!"

translate english carcel_0236:
    voice "voice/carcel_0236.ogg"
    c_voices "She is saved!"

translate english carcel_0237:
    voice "voice/carcel_0237.ogg"
    c_mephisto "Hither to me!"

