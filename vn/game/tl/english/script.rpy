translate english catedral_0018:
    voice "voice/catedral_0018.ogg"
    c_margarita "Woe! woe!\nWould I were free from the thoughts\nThat cross me, drawing hither and thither\nDespite me!"

translate english catedral_0022:
    c_chorus "Diesira, dies illa,\nSolvet soeclum in favilla!"

translate english catedral_0024:
