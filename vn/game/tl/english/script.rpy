    pass

translate english carcel_0229:
    voice "voice/carcel_0229.ogg"
    c_margarita "Thine am I, Father! rescue me!\nYe angels, holy cohorts, guard me,\nCamp around, and from evil ward me!\nHenry! I shudder to think of thee."

