  "context_before": [
    {
      "id": "prologo_teatro_0198",
      "speaker": "poet",
      "text": "la eterna sed de la ilusión brillante."
    },
    {
      "id": "prologo_teatro_0199",
      "speaker": "poet",
      "text": "Vuélveme la pasión nunca vencida;"
    },
    {
      "id": "prologo_teatro_0200",
      "speaker": "poet",
      "text": "la dicha humana, que profunda gime;"
    },
    {
      "id": "prologo_teatro_0201",
      "speaker": "poet",
      "text": "la fuerza que hace, al despertar la vida,"
    },
    {
      "id": "prologo_teatro_0202",
      "speaker": "poet",
      "text": "sangriento el odio y el amor sublime:"
    },
    {
      "id": "prologo_teatro_0203",
      "speaker": "poet",
      "text": "¡dame otra vez la juventud perdida!"
    }
  ],
  "lines": [
    {
      "id": "prologo_teatro_0204",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "¡La juventud! ¿Y para qué la quieres?",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0205",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "Si en dura lid acometido fueres;",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0206",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "si una mujer en torno de tu cuello",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0207",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "tendiera el brazo bello;",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0208",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "si allá en lejana meta",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0209",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "la que audaz ambiciona",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0210",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "el generoso atleta",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0211",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "vieras brillar, olímpica corona;",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0212",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "si tras la danza inquieta",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0213",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "te brindara la copa loca orgía,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0214",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "llorar la juventud justo sería.",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0215",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "Pero en cítara de oro",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0216",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "el vuelo de la libre fantasía",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0217",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "seguir y el canto acompañar sonoro,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0218",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "tarea, ¡oh mis señores los ancianos!,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0219",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "es adecuada a vuestras flacas manos.",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0220",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "Leí en libros añejos",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0221",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "que niños otra vez se hacen los viejos;",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0222",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "mas yo diré, si a la verdad me ciño,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0223",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "que al hombre la vejez sorprende aún niño.",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0224",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Ya de cháchara inútil basta y sobra;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0225",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "cerrad el pico, y manos a la obra.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0226",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Mientras charlabais, algo de provecho",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0227",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "pudierais haber hecho.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0228",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿De qué sirve la hueca teoría,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0229",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "si, de valor desnuda,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0230",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "la incertidumbre duda?",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0231",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿Poeta sois? Pues dadnos poesía.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0232",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Qué gusta al vulgo ¿lo ignoráis acaso?",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0233",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Pide su paladar licor hirviente;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0234",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "hasta los bordes, pues, llenadle el vaso;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0235",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "lo que hoy no hagáis, mañana os saldrá al paso,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0236",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "y un día habréis perdido tristemente.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0237",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Una idea coged por los cabellos:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0238",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "en nuestra patria escena",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0239",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "todo novel autor su drama estrena;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0240",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "haced lo que hacen ellos.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0241",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Compasión no tengáis del tramoyista:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0242",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "mudad decoraciones;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0243",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "haced brillar a nuestra absorta vista",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0244",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "la luz del cuarto y la del quinto cielo,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0245",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "y sin ningún recelo",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0246",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "derramad las estrellas a millones.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0247",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "La escena está provista",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0248",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "de riscos y de selvas y cascadas,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0249",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "de aves, monstruos y fieras.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0250",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "En esas cuatro tablas mal pintadas,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0251",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "orbes amontonad, cielos y esferas;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0252",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "y en vuelo cadencioso,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0253",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "desde el opaco mundo,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0254",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "remontadnos al cielo esplendoroso",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0255",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "y hundidnos en el báratro profundo.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    }
  ],
  "input_sha256": "e9aca2162e33781eea71004cf92f140989aa1f9b1c031eac79384709d82c56a2"
}
