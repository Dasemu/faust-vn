  "context_before": [
    {
      "id": "noche_0077",
      "speaker": "faust",
      "text": "al invocante Espíritu adoctrina."
    },
    {
      "id": "noche_0078",
      "speaker": "faust",
      "text": "Con las áridas reglas, nuestra mente"
    },
    {
      "id": "noche_0079",
      "speaker": "faust",
      "text": "los signos misteriosos no descifra;"
    },
    {
      "id": "noche_0080",
      "speaker": "faust",
      "text": "pues que vagáis, Espíritus, en torno,"
    },
    {
      "id": "noche_0081",
      "speaker": "faust",
      "text": "oíd, y contestad a la voz mía."
    },
    {
      "id": "noche_0082",
      "speaker": "narrator",
      "text": "Abre el libro y se presenta el signo del Macrocosmos."
    }
  ],
  "lines": [
    {
      "id": "noche_0083",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Cuán sabrosa fruición, ante esa imagen,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0084",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "mi ser inunda y mi sentido anima!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0085",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Por mis arterias y mis nervios corre",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0086",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "el santo hervor de renaciente vida.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0087",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¿Fue un Dios acaso quien trazó este signo,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0088",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "que el hondo afán del corazón mitiga,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0089",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "al Espíritu presta nuevas alas",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0090",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "y a la Naturaleza el velo quita?",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0091",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¿Un Dios yo mismo soy? Todo a mis ojos",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0092",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "aparece distinto: en esas líneas",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0093",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "vi a la Naturaleza productora,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0094",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "que al alma está patente y sometida.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0095",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "El Sabio dijo bien --hoy lo comprendo--:",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0096",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "«Barrera impenetrable no limita",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0097",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "el mundo del Espíritu: ¿está muerto",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0098",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "tu pobre corazón, tu alma rendida?",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0099",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Álzate, pues, y tu terrena frente",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0100",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "baña en el rosicler del nuevo día!»",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0101",
      "kind": "direction",
      "speaker": null,
      "speaker_note": null,
      "text": "Contempla el signo.",
      "defaults": {
        "speaker": "narrator",
        "kind": "stage_direction",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0102",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Todo se mueve, completando el todo,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0103",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "y cada parte enlázase distinta;",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0104",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "los celestes Espíritus, que ascienden",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0105",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "y descienden al par en dobles filas,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0106",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "pasan de mano en mano el áureo sello;",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0107",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "y en el éter batiendo alas benditas,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0108",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "van de la tierra al cielo, cielo y tierra",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0109",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "llenando de inefables armonías.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0110",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Bella visión, pero visión al cabo!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0111",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Cómo asir y estrechar a la infinita",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0112",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Naturaleza, y exprimir sus pechos!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0113",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Manantial ellos son de toda vida;",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0114",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "de ellos penden los cielos y la tierra;",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0115",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "su fecundo raudal todo lo anima,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0116",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "y en vano pide mi sediento labio",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0117",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "una gota, no más, de esa ambrosía.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0118",
      "kind": "direction",
      "speaker": null,
      "speaker_note": null,
      "text": "Vuelve la hoja involuntariamente y ve el signo del Espíritu de la Tierra.",
      "defaults": {
        "speaker": "narrator",
        "kind": "stage_direction",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0119",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Cuánto es diversa, Genio de la Tierra,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0120",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "tu acción! Estás más cerca, y a tu vista",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0121",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "crecen mis bríos, cual si rojo mosto",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0122",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "inundara mi ser: con frente erguida",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0123",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "quiero lanzarme al mundo; afrontar quiero",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0124",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "sus infortunios, afrontar sus dichas;",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0125",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "provocar la tormenta, y sin espanto",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0126",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "ver la nave a mis pies rota y hundida.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    }
  ],
