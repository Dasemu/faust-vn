  "context_before": [
    {
      "id": "prologo_teatro_0045",
      "speaker": "poet",
      "text": "y aparece después y asombra al mundo"
    },
    {
      "id": "prologo_teatro_0046",
      "speaker": "poet",
      "text": "del esplendor de la beldad ceñido."
    },
    {
      "id": "prologo_teatro_0047",
      "speaker": "poet",
      "text": "Lo brillante, que viste oropel vano,"
    },
    {
      "id": "prologo_teatro_0048",
      "speaker": "poet",
      "text": "fugaz momento dura; pero el sello"
    },
    {
      "id": "prologo_teatro_0049",
      "speaker": "poet",
      "text": "de la inmortalidad ostenta ufano"
    },
    {
      "id": "prologo_teatro_0050",
      "speaker": "poet",
      "text": "y para el porvenir vive lo bello."
    }
  ],
  "lines": [
    {
      "id": "prologo_teatro_0051",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "¡El porvenir! ¡El porvenir!... ¡Manía!",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0052",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "Si yo en el porvenir también pensase,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0053",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "a los presentes --¡respetable clase!--",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0054",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "¿quién los divertiría?",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0055",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "Quieren reír, y con razón. Da gozo",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0056",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "ver salir a las tablas un buen mozo;",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0057",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "y si sabe expresar su pensamiento,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0058",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "¿para qué otro recurso?",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0059",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "Cuanto más numeroso es el concurso,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0060",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "lo conmueve mejor. Tomad aliento",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0061",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "y obrad con energía.",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0062",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "Suelta dad a la errante Fantasía;",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0063",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "la Razón, la Agudeza, el Sentimiento",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0064",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "vayan en seguimiento;",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0065",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "y si queréis que la obra satisfaga,",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0066",
      "kind": "verse",
      "speaker": "clown",
      "speaker_note": null,
      "text": "la loca Insensatez no quede en zaga.",
      "defaults": {
        "speaker": "clown",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0067",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Procurad, ante todo,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0068",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "que la acción sea vasta y estupenda:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0069",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "el vulgo, a cuyo gusto me acomodo,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0070",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "quiere ver mucho, aun cuando no lo entienda.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0071",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Si embrolláis vuestra fábula de modo",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0072",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "que el abobado espectador se asombre,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0073",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "la victoria es cabal; sois el gran hombre.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0074",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "A muchos, dadles mucho. Bien presente",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0075",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "tened que cada cual algo desea",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0076",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "hallar en la obra que a su afán se ajuste:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0077",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "cuanto más varia y complicada sea,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0078",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "más fácil será, pues, que cada oyente",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0079",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "encuentre alguna cosa que le guste.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0080",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Pensar en unidades es simpleza;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0081",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "servidnos bien trinchada vuestra pieza:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0082",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿por qué buscar armónico conjunto,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0083",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "si cada cual os lo destroza al punto?",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0084",
      "kind": "verse",
      "speaker": "poet",
      "speaker_note": null,
      "text": "¡Industria degradada",
      "defaults": {
        "speaker": "poet",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0085",
      "kind": "verse",
      "speaker": "poet",
      "speaker_note": null,
      "text": "a la que nunca se doblega el Arte!",
      "defaults": {
        "speaker": "poet",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0086",
      "kind": "verse",
      "speaker": "poet",
      "speaker_note": null,
      "text": "La de los charlatanes tropa osada",
      "defaults": {
        "speaker": "poet",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0087",
      "kind": "verse",
      "speaker": "poet",
      "speaker_note": null,
      "text": "¿ya os puso de su parte?",
      "defaults": {
        "speaker": "poet",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    }
  ],
  "input_sha256": "b384a738907aabaa83512ffb28281d630e09c970229033e8b05cb4494ce6077b"
}
