  "context_before": [
    {
      "id": "noche_0055",
      "speaker": "faust",
      "text": "que el polvo ensucia y muerde la polilla;"
    },
    {
      "id": "noche_0056",
      "speaker": "faust",
      "text": "papelotes y viejos pergaminos"
    },
    {
      "id": "noche_0057",
      "speaker": "faust",
      "text": "suben al techo en apretadas pilas."
    },
    {
      "id": "noche_0058",
      "speaker": "faust",
      "text": "Cóncavos vidrios, botes y redomas,"
    },
    {
      "id": "noche_0059",
      "speaker": "faust",
      "text": "extraños instrumentos hechos trizas"
    },
    {
      "id": "noche_0060",
      "speaker": "faust",
      "text": "--¡única y triste herencia de mis padres!--,"
    }
  ],
  "lines": [
    {
      "id": "noche_0061",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡mi vida llenan, si mi vida es vida!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0062",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Y pregunto: ¿por qué, medroso y débil,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0063",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "mi desmayado corazón palpita?",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0064",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Y pregunto: ¿por qué mortal angustia",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0065",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "mis flacas pulsaciones paraliza?",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0066",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Lo pregunto, y sin ti, Naturaleza,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0067",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "en cuyo seno Dios nos forma y cría,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0068",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "en el polvo, en el humo y la carcoma,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0069",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "vivo enterrado entre osamentas frías.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0070",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Fuera de aquí! ¡Luz! ¡Aire! ¡Campo abierto!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0071",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Este libro me da segura guía:",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0072",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "por la mano del docto Nostradamus",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0073",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "fueron todas sus páginas escritas.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0074",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "El curso aprenderé de las estrellas,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0075",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "y de nueva virtud mi alma provista,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0076",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "sabré cómo el Espíritu invocado",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0077",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "al invocante Espíritu adoctrina.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0078",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Con las áridas reglas, nuestra mente",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0079",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "los signos misteriosos no descifra;",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0080",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "pues que vagáis, Espíritus, en torno,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0081",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "oíd, y contestad a la voz mía.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0082",
      "kind": "direction",
      "speaker": null,
      "speaker_note": null,
      "text": "Abre el libro y se presenta el signo del Macrocosmos.",
      "defaults": {
        "speaker": "narrator",
        "kind": "stage_direction",
        "location": "study",
        "time_of_day": "night"
      }
    }
  ],
