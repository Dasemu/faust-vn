      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "soy cual los gatos, que solo",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
