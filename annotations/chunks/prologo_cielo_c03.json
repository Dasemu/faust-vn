      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0114",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "Tentarlo puedes",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
