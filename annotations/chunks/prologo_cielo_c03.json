      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "confío en mi buena suerte,",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0136",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "y si ella el triunfo me otorga,",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
