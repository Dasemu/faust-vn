      "speaker": "mephisto",
      "speaker_note": null,
      "text": "a medias conciencia tiene;",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0096",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "al cielo le pide el astro",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
