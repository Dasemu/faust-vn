      "id": "prologo_cielo_0138",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "El doctor morderá el polvo,",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
