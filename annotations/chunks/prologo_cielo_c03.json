      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "lo morderá relamiéndose,",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
