      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "y al mundo la más intensa",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
