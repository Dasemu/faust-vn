        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0116",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "de errar quien busca y pretende",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
