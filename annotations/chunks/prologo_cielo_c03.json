      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "a que tu siervo te vende,",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0112",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "si llevarlo por mis sendas",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0113",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
