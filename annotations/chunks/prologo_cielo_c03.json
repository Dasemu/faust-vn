      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "y ni el cielo ni la tierra",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0101",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
