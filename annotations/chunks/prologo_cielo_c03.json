      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "el camino recto encuentra",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
