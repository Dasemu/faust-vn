      "id": "prologo_cielo_0120",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "los muertos. Carnes rollizas",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0121",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "y frescas son mi deleite.",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
