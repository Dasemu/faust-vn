      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "Señor, pues no me apetecen",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
