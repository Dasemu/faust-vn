      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "que sus labios no desdeñen;",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
