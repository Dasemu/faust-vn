        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0129",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "y el cauce, si sabes, tuerce;",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
