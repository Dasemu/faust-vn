      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "entre tantas lobregueces.",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0134",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "No ha de ser larga la prueba:",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
