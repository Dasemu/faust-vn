      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "sensación de sus placeres;",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
