      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0126",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
