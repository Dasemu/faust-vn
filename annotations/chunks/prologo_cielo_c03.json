      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "brillará la luz mañana.",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0107",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "Bien el hortelano entiende,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0108",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "cuando el botón rompe el árbol,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
