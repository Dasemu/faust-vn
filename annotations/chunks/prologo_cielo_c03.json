      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "Si se trata de un cadáver,",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
