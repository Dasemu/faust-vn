      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "De su insensata locura",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
