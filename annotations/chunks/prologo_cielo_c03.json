      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": null,
      "text": "los lauros no me cercenes.",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
