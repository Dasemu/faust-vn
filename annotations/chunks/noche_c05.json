  "context_before": [
    {
      "id": "noche_0140",
      "speaker": "faust",
      "text": "mis sentimientos lidian,"
    },
    {
      "id": "noche_0141",
      "speaker": "faust",
      "text": "y hacia ti, fatal Genio,"
    },
    {
      "id": "noche_0142",
      "speaker": "faust",
      "text": "todos se precipitan."
    },
    {
      "id": "noche_0143",
      "speaker": "faust",
      "text": "¡Preséntate, aunque fuere"
    },
    {
      "id": "noche_0144",
      "speaker": "faust",
      "text": "al precio de mi vida!"
    },
    {
      "id": "noche_0145",
      "speaker": "narrator",
      "text": "Toma el libro y pronuncia misteriosamente el nombre del Espíritu. Enciéndese una luz rojiza y trémula. El Espíritu aparece en ella."
    }
  ],
  "lines": [
    {
      "id": "noche_0146",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "¿Quién me llama?",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0147",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Visión espantadora!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0148",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "Audaz me evocas y a venir me obligas,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0149",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "y ahora...",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0150",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Me aterra tu presencia. Aparta...",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0151",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "Con largo afán llamábasme, y querías",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0152",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "ver mi semblante y escuchar mi acento;",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0153",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "cedo a tu voz, preséntome a tu vista:",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0154",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "¿qué cobarde congoja rinde y postra",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0155",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "tu valor sobrehumano? ¿Quién tu altiva",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0156",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "aspiración rindió? ¿Por qué desmaya",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0157",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "el corazón soberbio, que en sus vivas",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0158",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "palpitaciones engendraba un mundo,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0159",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "y con su propia savia lo nutría?",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0160",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "¿Cómo sucumbes, si tender el vuelo",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0161",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "al par de los Espíritus querías?",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0162",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "¡Y eres tú Fausto, el Fausto que me invoca!",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0163",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "¡Eres tú Fausto, y, ¡despreciable hormiga!,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0164",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "al soplo solo de mi voz, heladas",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0165",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "temblaron tus entrañas conmovidas!",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0166",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Oh, no, roja visión, hijo del fuego!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0167",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Soy Fausto, soy tu igual; no me intimidas.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0168",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "En la incesante ráfaga",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0169",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "de actividad continua,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0170",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "vuelo de arriba abajo,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0171",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "vuelo de abajo arriba;",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0172",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "y en ese veloz torno,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0173",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "que el Tiempo mueve y gira,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0174",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "mis dedos impalpables",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0175",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "las tenues hebras hilan",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0176",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "de la vida y la muerte,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0177",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "de la muerte y la vida,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0178",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "tejiendo a Dios, en el telar eterno,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0179",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "la que viste inmortal túnica viva.",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0180",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Cómo sintiendo voy que a ti me acerco,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0181",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Espíritu que flotas y te agitas",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0182",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "sobre el mundo!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0183",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "Al Espíritu que sueñas",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0184",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "y tu mente concibe, te aproximas,",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0185",
      "kind": "verse",
      "speaker": "spirit",
      "speaker_note": null,
      "text": "no a mí.",
      "defaults": {
        "speaker": "spirit",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0186",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": "aterrado",
      "text": "¿No a ti? Pues dime: ¿a quién? ¿Imagen",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0187",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": "aterrado",
      "text": "soy de Dios, y ni a ti llegar podría?",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    }
