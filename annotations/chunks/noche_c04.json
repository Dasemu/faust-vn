      "speaker_note": null,
      "text": "siniestro se aproxima.",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
      "id": "noche_0137",
      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "¡Rasga el velo! ¡Aparece!",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
