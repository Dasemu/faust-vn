      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "Vertiginoso anhelo",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
    {
