      "kind": "verse",
      "speaker": "faust",
      "speaker_note": null,
      "text": "y hacia ti, fatal Genio,",
      "defaults": {
        "speaker": "faust",
        "kind": "dialogue",
        "location": "study",
        "time_of_day": "night"
      }
    },
