  "context_before": [],
  "lines": [
    {
      "id": "dedicatoria_0001",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "Tornáis de nuevo, hermosas imágenes flotantes,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0002",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "que dulce y melancólico un día contemplé.",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0003",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "¿Asiros y teneros podré feliz como antes?",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0004",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "¡Aún vuela hacia vosotras el alma cuando os ve!",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0005",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "Venid, y medio envueltas en el brumoso velo,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0006",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "a mi poder sumisas, girad en derredor;",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0007",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "el corazón aún late con juvenil anhelo,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0008",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "si aspira vuestro mágico aliento hechizador.",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0009",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "Hoy vuelven de otro tiempo mejor la alegre historia,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0010",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "y las risueñas sombras de la feliz edad,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0011",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "y como añejo cuento, perdido en la memoria,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0012",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "sus cándidos amores, su crédula amistad;",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0013",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "y aquel hondo lamento que en las revueltas vías",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0014",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "de la existencia, amargo, del corazón brotó,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0015",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "y los queridos seres que en venturosos días",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0016",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "la momentánea dicha traidora nos robó.",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0017",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "No escucharéis gozosos mi renaciente canto,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0018",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "vosotros para quienes la cítara pulsé;",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0019",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "deshízose ¡ay! el coro que comprendió su encanto,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0020",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "apenas apagándose el eco débil fue.",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0021",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "Hoy mis acentos oye tropel desconocido,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0022",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "y hasta su mismo aplauso me hiela el corazón;",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0023",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "los pocos que a mi canto prestaran el oído,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0024",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "si alientan, lejos viven en triste dispersión.",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0025",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "Al reino de los puros espíritus me impulsa",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0026",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "afán en mí dormido, que despertando va;",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0027",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "mas, como el arpa eolia, que un soplo errante pulsa,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0028",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "incoherentes notas mi labio al viento da.",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0029",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "Del alma opresa brotan suspiro tras suspiro;",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0030",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "ternura enervadora siento surgir en mí:",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0031",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "cuanto poseo y gozo como apariencia miro,",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "dedicatoria_0032",
      "kind": "verse",
      "speaker": null,
      "speaker_note": null,
      "text": "y como bien presente cuanto gocé y perdí.",
      "defaults": {
        "speaker": "poet_voice",
        "kind": "narration",
        "location": "dedication",
        "time_of_day": "timeless"
      }
    }
  ],
