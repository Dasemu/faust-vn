  "context_before": [
    {
      "id": "prologo_cielo_0136",
      "speaker": "mephisto",
      "text": "y si ella el triunfo me otorga,"
    },
    {
      "id": "prologo_cielo_0137",
      "speaker": "mephisto",
      "text": "los lauros no me cercenes."
    },
    {
      "id": "prologo_cielo_0138",
      "speaker": "mephisto",
      "text": "El doctor morderá el polvo,"
    },
    {
      "id": "prologo_cielo_0139",
      "speaker": "mephisto",
      "text": "lo morderá relamiéndose,"
    },
    {
      "id": "prologo_cielo_0140",
      "speaker": "mephisto",
      "text": "como aquella del manzano"
    },
    {
      "id": "prologo_cielo_0141",
      "speaker": "mephisto",
      "text": "mi buena tía la Sierpe."
    }
  ],
  "lines": [
    {
      "id": "prologo_cielo_0142",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "Ancho campo te concedo.",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0143",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "Nunca odié a los de tu especie;",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0144",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "entre todos los que niegan,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0145",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "genios a mi ley rebeldes,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0146",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "pobre bufón malicioso,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0147",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "el menos dañino tú eres.",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0148",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "El hombre, a menudo, en brazos",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0149",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "del reposo desfallece,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0150",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "y es bueno que en el camino",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0151",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "le anime, aguije y despierte",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0152",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "un compañero de viaje,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0153",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "aunque el mismo diablo fuere.",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0154",
      "kind": "direction",
      "speaker": null,
      "speaker_note": null,
      "text": "A los Arcángeles.",
      "defaults": {
        "speaker": "narrator",
        "kind": "stage_direction",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0155",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "La que brilla inmortal santa hermosura",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0156",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "gozad, hijos de Dios, en mi regazo;",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0157",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "la sustancia, que vive eterna y pura,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0158",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "de amor os ligue con el tierno lazo,",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0159",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "y a la incierta apariencia del momento",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0160",
      "kind": "verse",
      "speaker": "lord",
      "speaker_note": null,
      "text": "forma dé vuestro fijo pensamiento.",
      "defaults": {
        "speaker": "lord",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0161",
      "kind": "direction",
      "speaker": null,
      "speaker_note": null,
      "text": "El cielo se cierra y los Arcángeles se dispersan.",
      "defaults": {
        "speaker": "narrator",
        "kind": "stage_direction",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0162",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": "solo",
      "text": "De vez en cuando olvido mis rencillas,",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0163",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": "solo",
      "text": "y busco al Viejo, y pláticas entablo.",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0164",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": "solo",
      "text": "Pláceme que un Señor de campanillas",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
    },
    {
      "id": "prologo_cielo_0165",
      "kind": "verse",
      "speaker": "mephisto",
      "speaker_note": "solo",
      "text": "trate con atención a un pobre diablo.",
      "defaults": {
        "speaker": "mephisto",
        "kind": "dialogue",
        "location": "heaven",
        "time_of_day": "timeless"
      }
