  "context_before": [
    {
      "id": "prologo_teatro_0082",
      "speaker": "director",
      "text": "¿por qué buscar armónico conjunto,"
    },
    {
      "id": "prologo_teatro_0083",
      "speaker": "director",
      "text": "si cada cual os lo destroza al punto?"
    },
    {
      "id": "prologo_teatro_0084",
      "speaker": "poet",
      "text": "¡Industria degradada"
    },
    {
      "id": "prologo_teatro_0085",
      "speaker": "poet",
      "text": "a la que nunca se doblega el Arte!"
    },
    {
      "id": "prologo_teatro_0086",
      "speaker": "poet",
      "text": "La de los charlatanes tropa osada"
    },
    {
      "id": "prologo_teatro_0087",
      "speaker": "poet",
      "text": "¿ya os puso de su parte?"
    }
  ],
  "lines": [
    {
      "id": "prologo_teatro_0088",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Impropio es tal reproche:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0089",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿no ha de tomar el operario en cuenta",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0090",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "cuál será la más útil herramienta?",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0091",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿Para quién escribís? Aquí la noche",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0092",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "pasa el que sufre el tedio de la holganza,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0093",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "el que llenó, en hartazgos nada módicos,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0094",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "de pesado manjar la oronda panza,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0095",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "o el menguado caletre de periódicos.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0096",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Vienen como al paseo,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0097",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "al circo o a las máscaras: la inquieta",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0098",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "curiosidad les guía, o la costumbre.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0099",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Las bellas, con sus galas y su arreo,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0100",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "nos dan otro espectáculo. Poeta,",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0101",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿qué es lo que sueñas en la excelsa cumbre?",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0102",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿Te envanece quizás el teatro lleno?",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0103",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Baja y mira tu gente:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0104",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "este se maravilla, al arte ajeno;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0105",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "aquel, docto, bosteza indiferente.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0106",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Hay quien está soñando en los tesoros",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0107",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "que le brindan las copas o los oros;",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0108",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "hay quien pensando goza",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0109",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "que le aguardan los brazos de su moza.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0110",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¡Por ellos, vates, molestáis con grave",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0111",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "ansia a la Musa en su región serena!...",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0112",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Dadnos mucho, y aún más, y aún más, si cabe:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0113",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "ese es todo el secreto de la escena.",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0114",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "Satisfacer al auditorio es cosa",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0115",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "asaz dificultosa:",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0116",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "entretenedlo, divertidlo. Pero",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0117",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿qué tenéis? ¿Qué os acosa?",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    },
    {
      "id": "prologo_teatro_0118",
      "kind": "verse",
      "speaker": "director",
      "speaker_note": null,
      "text": "¿Es júbilo? ¿Es dolor?...",
      "defaults": {
        "speaker": "director",
        "kind": "dialogue",
        "location": "theatre",
        "time_of_day": "day"
      }
    }
  ],
